{{!< default}}
{{> "navbar" }}
<div class="site-wrapper">
    <div class="hero-section">
        <div class="concrete-gradient"></div>
        <div class="profile-container">
            <div class="profile-wrapper">
                <img src="{{@site.logo}}" alt="Sergey" class="profile-image">
            </div>
        </div>
    </div>

    <main class="content-section">
        <div class="content-wrapper">
            <div class="intro-content">
                <p class="about-text">
                    <span class="info-icon">👋</span> hi, my name is sergey. i’m a product engineer with <span id="num-work-years"></span>+ years of experience building software across different domains. my work focuses on making complex systems feel simple and useful.
                </p>
                <p class="about-text">
                    in recent years, i’ve worked mainly in startup environments, navigating ambiguity through experimentation, system design, and iterative product development.
                </p>
            </div>

            <section class="info-section">
                <p class="title">what i'm doing right now</p>
                <ul class="current-list">
                    <li><span class="info-icon">🛒</span> leading development of <a class="inline-link" href="https://blog.mashgin.com/ai-retail/mashgin-launches-power-counter-redefining-c-store-efficiency">power counter</a>, helping bring ai-assisted checkout to convenience stores.</li>
                    <li><span class="info-icon">🔎</span> interviewing small and midsize business owners as part of an independent research project to better understand their workflows and tools.</li>
                </ul>
            </section>

            <section class="info-section">
                <p class="title">let's collaborate</p>
                <p class="about-text">
                    while my current role keeps me busy, i'm always interested in connecting with people about innovative ideas or meaningful projects. if you're a business owner who wants an independent perspective on your current workflows and tools, let's talk. feel free to reach out on linkedin or email me at <a href="mailto:contact@sergeycoder.com" class="inline-link">contact@sergeycoder.com</a>
                </p>
            </section>

            <footer class="site-footer">
                <p class="copyright">© 2024 all rights reserved</p>
            </footer>
        </div>
    </main>
</div>
